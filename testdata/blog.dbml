Table "nopk" {
  "id" varchar(36) [not null]

  records ("id") {
    'e42c77c6-06a4-4502-816c-d112c7142e6d'
  }
}

Table "post_tags" {
  "id" int [pk, increment]
  "post_id" int [not null]
  "tag_id" int [not null]

  indexes {
    ("post_id", "tag_id") [unique, name: "post_tags_post_id_tag_id_key"]
    ("post_id") [name: "post_id"]
    ("tag_id") [name: "tag_id"]
  }

  records ("id", "post_id", "tag_id") {
    '1', '1', '1'
    '2', '1', '2'
    '3', '2', '1'
    '4', '2', '2'
  }
}

Table "products" {
  "id" int [pk, increment]
  "name" varchar(255) [not null]
  "price" decimal(10,2) [not null]
  "properties" text [not null]
  "created_at" datetime [not null]
  "deleted_at" datetime

  records ("id", "name", "price", "properties", "created_at", "deleted_at") {
    '1', 'Calculator', '23.01', '{"depth":false,"model":"TRX-120","width":100,"height":null}', '1970-01-01 01:01:01', null
  }
}

Table "tags" {
  "id" int [pk, increment]
  "name" varchar(255) [not null]
  "is_important" bit(1) [not null]

  records ("id", "name", "is_important") {
    '1', 'funny', `X'00'`
    '2', 'important', `X'01'`
  }
}

Table "users" {
  "id" int [pk, increment]
  "username" varchar(255) [not null]
  "password" varchar(255) [not null]
  "api_key" varchar(255)
  "location" point

  records ("id", "username", "password", "api_key", "location") {
    '1', 'user1', 'pass1', '123456789abc', null
    '2', 'user2', '$2y$10$cg7/nswxVZ0cmVIsMB/pVOh1OfcHScBJGq7Xu4KF9dFEQgRZ8HWe.', null, null
  }
}

Ref: "abc_posts"."abc_category_id" > "categories"."id"
Ref: "abc_posts"."abc_user_id" > "users"."id"
Ref: "barcodes"."product_id" > "products"."id"
Ref: "comments"."category_id" > "categories"."id"
Ref: "comments"."post_id" > "abc_posts"."abc_id"
Ref: "kunsthåndværk"."invisible_id" > "invisibles"."id"
Ref: "kunsthåndværk"."user_id" > "users"."id"
Ref: "post_tags"."post_id" > "abc_posts"."abc_id"
Ref: "post_tags"."tag_id" > "tags"."id"
