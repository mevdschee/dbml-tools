Project {
  database_type: 'normalized'
}

Table "abc_posts" {
  "abc_id" serial [pk]
  "abc_user_id" int [not null]
  "abc_category_id" int [not null]
  "abc_content" varchar(255) [not null]

  indexes {
    ("abc_category_id") [name: "abc_category_id"]
    ("abc_user_id") [name: "abc_user_id"]
  }
}

Table "barcodes" {
  "id" serial [pk]
  "product_id" int [not null]
  "hex" varchar(255) [not null]
  "bin" binary [not null]
  "ip_address" varchar(15)
}

Table "categories" {
  "id" serial [pk, note: "The identifier of the category."]
  "name" varchar(255) [not null, note: "The name of the category."]
  "icon" binary [note: "A small image representing the category."]

  Note: "The post categories of the blog system."
}

Table "comments" {
  "id" bigserial [pk]
  "post_id" int [not null]
  "message" varchar(255) [not null]
  "category_id" int [not null]

  indexes {
    ("post_id") [name: "post_id"]
  }
}

Table "countries" {
  "id" serial [pk]
  "name" varchar(255) [not null]
  "shape" geometry [not null]
}

Table "events" {
  "id" serial [pk]
  "name" varchar(255) [not null]
  "datetime" datetime
  "visitors" bigint
}

Table "invisibles" {
  "id" varchar(36) [pk, not null]
}

Table "kunsthåndværk" {
  "id" varchar(36) [pk, not null]
  "Umlauts ä_ö_ü-COUNT" int [unique, not null]
  "user_id" int [not null]
  "invisible" varchar(36)
  "invisible_id" varchar(36)
}

Table "nopk" {
  "id" varchar(36) [not null]
}

Table "post_tags" {
  "id" serial [pk]
  "post_id" int [not null]
  "tag_id" int [not null]

  indexes {
    ("post_id", "tag_id") [unique, name: "post_tags_post_id_tag_id_key"]
    ("post_id") [name: "post_id"]
    ("tag_id") [name: "tag_id"]
  }
}

Table "products" {
  "id" serial [pk]
  "name" varchar(255) [not null]
  "price" decimal(10,2) [not null]
  "properties" text [not null]
  "created_at" datetime [not null]
  "deleted_at" datetime
}

Table "tags" {
  "id" serial [pk]
  "name" varchar(255) [not null]
  "is_important" bit(1) [not null]
}

Table "users" {
  "id" serial [pk]
  "username" varchar(255) [not null]
  "password" varchar(255) [not null]
  "api_key" varchar(255)
  "location" point
}

Ref: "abc_posts"."abc_category_id" > "categories"."id"
Ref: "abc_posts"."abc_user_id" > "users"."id"
Ref: "barcodes"."product_id" > "products"."id"
Ref: "comments"."category_id" > "categories"."id"
Ref: "comments"."post_id" > "abc_posts"."abc_id"
Ref: "kunsthåndværk"."invisible_id" > "invisibles"."id"
Ref: "kunsthåndværk"."user_id" > "users"."id"
Ref: "post_tags"."post_id" > "abc_posts"."abc_id"
Ref: "post_tags"."tag_id" > "tags"."id"
