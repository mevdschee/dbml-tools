Table "events" {
  "id" int [pk, increment]
  "name" varchar(255) [not null]
  "datetime" datetime
  "visitors" bigint

  records ("id", "name", "datetime", "visitors") {
    '1', 'Launch', '2016-01-01 13:01:01', '0'
  }
}

Table "invisibles" {
  "id" varchar(36) [pk, not null]

  records ("id") {
    'e42c77c6-06a4-4502-816c-d112c7142e6d'
  }
}

Table "kunsthåndværk" {
  "id" varchar(36) [pk, not null]
  "Umlauts ä_ö_ü-COUNT" int [unique, not null]
  "user_id" int [not null]
  "invisible" varchar(36)
  "invisible_id" varchar(36)

  records ("id", "Umlauts ä_ö_ü-COUNT", "user_id", "invisible", "invisible_id") {
    'e31ecfe6-591f-4660-9fbd-1a232083037f', 2, 2, null, 'e42c77c6-06a4-4502-816c-d112c7142e6d'
    'e42c77c6-06a4-4502-816c-d112c7142e6d', 1, 1, null, 'e42c77c6-06a4-4502-816c-d112c7142e6d'
