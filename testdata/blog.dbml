Project "blog" {
  database_type: 'MariaDB normalized'
}

Table "abc_posts" {
  "abc_id" int [pk, increment]
  "abc_user_id" int [not null]
  "abc_category_id" int [not null]
  "abc_content" varchar(255) [not null]

  indexes {
    ("abc_category_id") [name: "abc_category_id"]
    ("abc_user_id") [name: "abc_user_id"]
  }

  records ("abc_id", "abc_user_id", "abc_category_id", "abc_content") {
    '1', '1', '1', 'blog started'
    '2', '1', '2', 'It works!'
  }
}

Table "barcodes" {
  "id" int [pk, increment]
  "product_id" int [not null]
  "hex" varchar(255) [not null]
  "bin" binary [not null]
  "ip_address" varchar(15)

  records ("id", "product_id", "hex", "bin", "ip_address") {
    '1', '1', '00ff01', `X'00ff01'`, '127.0.0.1'
  }
}

Table "categories" {
  "id" serial [pk, note: "The identifier of the category."]
  "name" varchar(255) [not null, note: "The name of the category."]
  "icon" binary [note: "A small image representing the category."]

  records ("id", "name", "icon") {
    '1', 'announcement', null
    '2', 'article', null
    '3', 'comment', null
  }

  Note: "The post categories of the blog system."
}

Table "comments" {
  "id" int [pk, increment]
  "post_id" int [not null]
  "message" varchar(255) [not null]
  "category_id" int [not null]

  indexes {
    ("post_id") [name: "post_id"]
  }

  records ("id", "post_id", "message", "category_id") {
    '1', '1', 'great', '3'
    '2', '1', 'fantastic', '3'
    '3', '2', 'thank you', '3'
    '4', '2', 'awesome', '3'
  }
}

Table "countries" {
  "id" int [pk, increment]
  "name" varchar(255) [not null]
  "shape" geometry [not null]

  records ("id", "name", "shape") {
    '1', 'Left', `X'e6100000010300000001000000050000000000000000003e4000000000000024400000000000004440000000000000444000000000000034400000000000004440000000000000244000000000000034400000000000003e400000000000002440'`
